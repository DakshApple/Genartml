# Genartml Backend Configuration Example
# Copy this file to .env and configure as needed.

# =========================================================
# 1. Easiest FREE Instant Email to your Inbox (Choose One)
# =========================================================

# Option A: FormSubmit (Zero setup! Just put your receiving email)
NOTIFICATION_EMAIL=your-email@gmail.com

# Option B: Web3Forms (100% Free - get key instantly at https://web3forms.com)
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Option C: Resend API Key (Free 3,000 emails/mo at https://resend.com)
RESEND_API_KEY=re_123456789

# =========================================================
# 2. Supabase Database Integration (Optional)
# =========================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =========================================================
# 3. Discord / Slack Live Webhooks (Optional)
# =========================================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# =========================================================
# 4. Admin API Protection (Optional)
# =========================================================
# Secret key required to query GET /api/leads with x-admin-key header
ADMIN_SECRET_KEY=genartml_admin_secret_key_2026
